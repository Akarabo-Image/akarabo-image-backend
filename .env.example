# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api

# Database
# DB_TYPE: 'postgres' (use a real PostgreSQL server) or 'sqljs' (embedded, zero-setup dev fallback)
DB_TYPE=sqljs
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=akarabo_studio
DB_SSL=false
# Only for quick local prototyping. Migrations remain the source of truth.
DB_SYNCHRONIZE=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Firebase Admin (keep service-account JSON only in the backend secret store)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Initial owner account (created by `npm run seed`)
SEED_OWNER_NAME=Studio Owner
SEED_OWNER_EMAIL=owner@akarabo.rw
SEED_OWNER_PASSWORD=ChangeMe123!

# Uploads (photo files stored on local disk; DB keeps references only)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=20971520
